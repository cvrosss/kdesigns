<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ studio.full_name }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🌸</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&display=swap" rel="stylesheet">
        {% block stylesheets %}
            <link rel="stylesheet" href="/css/storefront.css">
        {% endblock %}
    </head>
    <body>
        {% set navbar_transparent = navbar_transparent|default(false) %}
        {{ include('partials/_navbar.html.twig', {transparent: navbar_transparent}) }}

        <main class="site-main{{ navbar_transparent ? '' : ' site-main--offset' }}">
            {% block body %}{% endblock %}
        </main>

        {{ include('partials/_footer.html.twig') }}

        {% block javascripts %}
            <script src="/js/storefront.js" defer></script>
        {% endblock %}
    </body>
</html>
