<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ studio.full_name }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🌸</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&display=swap" rel="stylesheet">
        {% block stylesheets %}
            <link rel="stylesheet" href="/css/storefront.css">
        {% endblock %}
    </head>
    <body{{ app.user ? ' data-authenticated' : '' }}>
        {% set navbar_transparent = navbar_transparent|default(false) %}
        {{ include('partials/_navbar.html.twig', {transparent: navbar_transparent}) }}

        <main class="site-main{{ navbar_transparent ? '' : ' site-main--offset' }}">
            {% block body %}{% endblock %}
        </main>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_overview') }}" class="dashboard-fab">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 12l4-4"/><path d="M7.5 16.5a6 6 0 0 1 0-9"/></svg>
                Dashboard
            </a>
        {% endif %}

        {{ include('partials/_footer.html.twig') }}
        {{ include('partials/_auth_modal.html.twig') }}
        {{ include('partials/_order_modal.html.twig') }}
        {{ include('partials/_cart_drawer.html.twig') }}

        {# Utility classes are used by the order modal only; preflight is off so the storefront's own styles are untouched. #}
        <script src="https://cdn.tailwindcss.com/3.4.17"></script>
        <script>
            tailwind.config = {
                corePlugins: { preflight: false },
                theme: {
                    extend: {
                        colors: {
                            ink: '#1a1a1a', muted: '#6f655b', surface: '#faf6f0', 'cream-dark': '#ede5d8',
                            burgundy: { DEFAULT: '#5c0f12', dark: '#4a0c0f' },
                            rose: { DEFAULT: '#c46d7a', dark: '#b85b69' },
                            red: '#b42318'
                        },
                        fontFamily: { serif: ['Playfair Display', 'Georgia', 'serif'], sans: ['Inter', 'system-ui', 'sans-serif'] }
                    }
                }
            };
        </script>

        {% block javascripts %}
            <script src="/js/storefront.js" defer></script>
        {% endblock %}
    </body>
</html>
