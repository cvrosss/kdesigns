<section class="section section--cream story{{ page|default(false) ? ' story--page' : '' }}" id="about">
    <div class="container story__grid">
        <div class="story__media">
            <div class="story__badge">
                <strong>{{ story.years }}</strong>
                <span>Years</span>
            </div>
            <div class="story__img story__img--main">
                <img src="/{{ story.image_main }}" alt="A hand-tied KDesigns bouquet" loading="lazy" onerror="this.hidden=true">
            </div>
            <div class="story__img story__img--secondary">
                <img src="/{{ story.image_secondary }}" alt="Claire Ann Ross arranging flowers" loading="lazy" onerror="this.hidden=true">
            </div>
        </div>

        <div class="story__text">
            <p class="eyebrow eyebrow--rose">Our Story</p>
            <h2 class="heading heading--lg">Where flowers<br><em>tell stories</em></h2>
            {% for paragraph in story.paragraphs %}
                <p>{{ paragraph }}</p>
            {% endfor %}
            {% if story.stats %}
                <dl class="story__stats">
                    {% for stat in story.stats %}
                        <div>
                            <dt>{{ stat.label }}</dt>
                            <dd>{{ stat.value }}</dd>
                        </div>
                    {% endfor %}
                </dl>
            {% endif %}
        </div>
    </div>
</section>
