<div class="container">
    <form class="feedback" id="feedback" method="post" action="{{ path('app_feedback') }}">
        <h3 class="feedback__title">Share Your Experience</h3>
        <p class="feedback__sub">We'd love to hear from you.</p>

        {% for message in app.flashes('feedback_success') %}
            <p class="alert alert--success" role="status">{{ message }}</p>
        {% endfor %}
        {% for message in app.flashes('feedback_error') %}
            <p class="alert alert--error" role="alert">{{ message }}</p>
        {% endfor %}

        <input type="hidden" name="_token" value="{{ csrf_token('feedback') }}">

        <label for="feedback-name">Your Name</label>
        <input type="text" id="feedback-name" name="name" maxlength="80" placeholder="e.g. Maria Santos" required>

        <label for="feedback-message">Your Message</label>
        <textarea id="feedback-message" name="message" rows="4" maxlength="1000" placeholder="Tell us about your experience..." required></textarea>

        <button type="submit" class="btn btn--rose btn--block">Send Feedback</button>
    </form>
</div>
