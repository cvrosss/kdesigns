<div class="container">
    <div class="section__head section__head--center">
        <p class="eyebrow eyebrow--rose-light">Kind Words</p>
        <h2 class="heading heading--lg heading--light">What Our Clients Say</h2>
    </div>

    {% if testimonials %}
        <div class="carousel" data-carousel>
            <div class="carousel__track" data-carousel-track tabindex="0" role="region" aria-label="Client reviews">
                {% for testimonial in testimonials %}
                    <figure class="testimonial">
                        <span class="testimonial__mark" aria-hidden="true">&ldquo;</span>
                        <blockquote>{{ testimonial.quote }}</blockquote>
                        <figcaption>
                            <span class="avatar">{{ testimonial.initial }}</span>
                            <span>
                                <strong>{{ testimonial.author }}</strong>
                                <small>{{ testimonial.year }}</small>
                            </span>
                        </figcaption>
                    </figure>
                {% endfor %}
            </div>

            <div class="carousel__controls" data-carousel-controls>
                <button type="button" class="carousel__btn" data-carousel-prev aria-label="Previous reviews">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
                </button>
                <button type="button" class="carousel__btn" data-carousel-next aria-label="Next reviews">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
                </button>
            </div>
        </div>
    {% else %}
        <p class="empty empty--light">No reviews yet.</p>
    {% endif %}
</div>
