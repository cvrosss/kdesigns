{% set field_label = 'mb-2.5 block text-[11px] font-medium uppercase tracking-[.12em] text-[#6b5a4c]' %}
{% set field_input = 'block h-[46px] w-full rounded-[3px] border border-[#ddd0bd] bg-[#f3ece0] px-4 font-sans text-[15px] text-ink placeholder:text-[#9a8f82] focus:bg-white focus:outline focus:outline-2 focus:outline-offset-1 focus:outline-burgundy aria-[invalid=true]:border-red' %}
{% set method_btn = 'flex-1 cursor-pointer rounded-[3px] border border-[#ddd0bd] bg-surface px-4 py-[14px] font-sans text-[13px] font-semibold text-ink transition-colors hover:border-burgundy aria-pressed:border-burgundy aria-pressed:bg-burgundy aria-pressed:text-white' %}
{% set btn_ghost = 'flex-1 cursor-pointer rounded-[3px] border border-[#ddd0bd] bg-surface px-6 py-[15px] font-sans text-[13px] font-bold uppercase tracking-[.08em] text-burgundy hover:border-burgundy' %}
{% set btn_main = 'flex-[1.4] cursor-pointer rounded-[3px] border border-burgundy bg-burgundy px-6 py-[15px] font-sans text-[13px] font-bold uppercase tracking-[.08em] text-white hover:bg-burgundy-dark disabled:cursor-not-allowed disabled:border-[#d9ccb9] disabled:bg-[#d9ccb9] disabled:text-white/80' %}
{% set error_box = 'mb-0 mt-4 rounded-[3px] bg-[#fbeceb] px-3 py-2.5 text-[13px] leading-normal text-red' %}
{% set pay_btn = 'flex w-full cursor-pointer items-center gap-4 rounded-[3px] border border-[#ddd0bd] bg-white px-5 py-4 text-left font-sans text-ink transition-colors hover:border-burgundy aria-checked:border-burgundy aria-checked:shadow-[inset_0_0_0_1px_#5c0f12]' %}

<dialog class="m-auto max-h-[calc(100vh-32px)] w-[min(440px,calc(100vw-32px))] overflow-auto rounded-md border-0 bg-surface p-0 text-ink shadow-[0_24px_64px_rgba(30,10,12,.35)] backdrop:bg-[rgba(30,14,16,.55)] backdrop:backdrop-blur-[2px]"
        data-order aria-labelledby="order-title">
    <header class="relative bg-burgundy px-8 pb-6 pt-7 text-white">
        <p class="m-0 mb-2.5 text-[11px] font-semibold uppercase tracking-[.2em] text-white/50" data-order-overline>Place Order</p>
        <h2 class="m-0 font-serif text-2xl font-bold leading-tight" id="order-title" data-order-title></h2>
        <p class="m-0 mt-1.5 font-serif text-lg text-rose" data-order-price></p>
        <button type="button" class="absolute right-3 top-3 grid h-8 w-8 cursor-pointer place-items-center rounded-full border-0 bg-transparent text-white/70 hover:bg-white/10 hover:text-white" data-order-close aria-label="Close">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
    </header>

    {# Step 1: order details #}
    <form class="px-8 pb-8 pt-7" data-order-panel="details" novalidate>
        <label class="{{ field_label }}" for="order-name">Name <span class="text-rose-dark">*</span></label>
        <input class="{{ field_input }} mb-5" type="text" id="order-name" name="name" autocomplete="name" required>

        <label class="{{ field_label }}" for="order-contact">Contact No. <span class="text-rose-dark">*</span></label>
        <input class="{{ field_input }} mb-5" type="tel" id="order-contact" name="contact" placeholder="+63 9XX XXX XXXX" autocomplete="tel" inputmode="tel" required>

        <label class="{{ field_label }}" for="order-date">Date Needed <span class="text-rose-dark">*</span></label>
        <input class="{{ field_input }} mb-5" type="date" id="order-date" name="date" required data-order-date>

        <label class="{{ field_label }}" for="order-time">Time Needed</label>
        <select class="{{ field_input }} cursor-pointer" id="order-time" name="time">
            {% for i in 0..16 %}
                {% set minutes = 600 + i * 30 %}
                {% set hour = minutes // 60 %}
                <option value="{{ '%02d:%02d'|format(hour, minutes % 60) }}">{{ '%d:%02d %s'|format(hour > 12 ? hour - 12 : hour, minutes % 60, hour >= 12 ? 'PM' : 'AM') }}</option>
            {% endfor %}
        </select>
        <p class="mb-5 mt-2 text-xs text-muted">We are open 10:00 AM – 6:00 PM, Mon–Sat. Pre-orders only on Sundays.</p>

        <span class="{{ field_label }}" id="order-method-label">Fulfillment Method</span>
        <div class="flex gap-3" role="group" aria-labelledby="order-method-label">
            <button type="button" class="{{ method_btn }}" data-order-method="Pick Up" aria-pressed="true">🏪 Pick Up</button>
            <button type="button" class="{{ method_btn }}" data-order-method="Delivery" aria-pressed="false">🚚 Delivery</button>
        </div>

        <div class="mt-4 rounded-[3px] border border-[#ddd0bd] bg-[#ede5d8] px-4 py-4 text-[14px]" data-order-delivery-summary hidden>
            <p class="m-0 mb-2.5 text-[11px] font-bold uppercase tracking-[.12em] text-burgundy">Delivery Details</p>
            <p class="m-0 mb-1.5"><span aria-hidden="true">👤</span> <span data-summary-receiver></span></p>
            <p class="m-0 mb-1.5"><span aria-hidden="true">📞</span> <span data-summary-contact></span></p>
            <p class="m-0"><span aria-hidden="true">📍</span> <span data-summary-location></span></p>
            <button type="button" class="mt-3 cursor-pointer rounded-[3px] border border-[#ddd0bd] bg-surface px-3 py-1.5 font-sans text-xs font-semibold text-burgundy hover:border-burgundy" data-order-edit-receiver>Edit Details</button>
        </div>

        <p class="{{ error_box }}" role="alert" data-order-error hidden></p>

        <div class="mt-5 flex gap-3">
            <button type="button" class="{{ btn_ghost }}" data-order-close>Cancel</button>
            <button type="submit" class="{{ btn_main }}">Confirm Order</button>
        </div>
    </form>

    {# Delivery receiver details #}
    <form class="px-8 pb-8 pt-7" data-order-panel="receiver" novalidate hidden>
        <p class="mb-5 mt-0 text-sm text-muted">Who should we deliver to?</p>

        <label class="{{ field_label }}" for="order-receiver">Receiver Name <span class="text-rose-dark">*</span></label>
        <input class="{{ field_input }} mb-5" type="text" id="order-receiver" name="receiver" maxlength="150" autocomplete="off" required>

        <label class="{{ field_label }}" for="order-receiver-contact">Receiver Contact No. <span class="text-rose-dark">*</span></label>
        <input class="{{ field_input }} mb-5" type="tel" id="order-receiver-contact" name="receiverContact" maxlength="50" inputmode="tel" required>

        <label class="{{ field_label }}" for="order-location">Delivery Location <span class="text-rose-dark">*</span></label>
        <textarea class="{{ field_input }} h-24 py-3" id="order-location" name="location" maxlength="500" autocomplete="street-address" required></textarea>

        <p class="{{ error_box }}" role="alert" data-order-error hidden></p>

        <div class="mt-5 flex gap-3">
            <button type="button" class="{{ btn_ghost }}" data-order-back>Back</button>
            <button type="submit" class="{{ btn_main }}">Save Details</button>
        </div>
    </form>

    {# Step 2: payment method #}
    <div class="px-8 pb-8 pt-7" data-order-panel="payment" hidden>
        <p class="mb-5 mt-0 text-sm text-muted">Choose how you'd like to pay for your order.</p>
        <div class="flex flex-col gap-3" role="radiogroup" aria-label="Payment method">
            {% for pay in [
                {name: 'Pay at Shop', icon: '🏪', note: 'Pay in cash when you pick up or upon delivery'},
                {name: 'GCash', icon: '📱', note: 'Send payment via GCash — 09XX XXX XXXX'},
                {name: 'BDO', icon: '🏛️', note: 'BDO transfer — Acct No. XXXX-XXXX-XX'},
                {name: 'BPI', icon: '🏛️', note: 'BPI transfer — Acct No. XXXX-XXXX-XX'},
            ] %}
                <button type="button" class="{{ pay_btn }}" role="radio" aria-checked="false" data-order-payment="{{ pay.name }}">
                    <span class="text-2xl" aria-hidden="true">{{ pay.icon }}</span>
                    <span>
                        <span class="block text-[15px] font-semibold">{{ pay.name }}</span>
                        <span class="block text-[13px] text-muted">{{ pay.note }}</span>
                    </span>
                </button>
            {% endfor %}
        </div>

        <p class="{{ error_box }}" role="alert" data-order-error hidden></p>

        <div class="mt-5 flex gap-3">
            <button type="button" class="{{ btn_ghost }}" data-order-back>Back</button>
            <button type="button" class="{{ btn_main }}" data-order-select-payment disabled>Select Payment</button>
        </div>
    </div>

    {# E-receipt (GCash / BDO / BPI) #}
    <div class="px-8 pb-8 pt-6" data-order-panel="receipt" hidden>
        <p class="mx-auto mb-5 mt-0 w-fit rounded-full bg-[#ccf7e2] px-5 py-2 text-[12px] font-bold uppercase tracking-[.1em] text-[#0d6b45]">Payment Pending</p>
        <dl class="m-0 border-y border-dashed border-[#d9ccb9] py-4 text-[14px]">
            {% for row in [
                ['Reference No.', 'ref'], ['Date', 'today'], ['Payment Via', 'payment'], ['Product', 'product'],
                ['Fulfillment', 'fulfillment'], ['Date Needed', 'date'], ['Time', 'time'],
            ] %}
                <div class="flex justify-between gap-4 py-2">
                    <dt class="text-muted">{{ row[0] }}</dt>
                    <dd class="m-0 text-right font-semibold" data-receipt="{{ row[1] }}"></dd>
                </div>
            {% endfor %}
        </dl>
        <div class="flex items-center justify-between py-5">
            <span class="font-serif text-lg font-bold">Total</span>
            <span class="font-serif text-2xl font-bold text-burgundy" data-receipt="total"></span>
        </div>
        <p class="mb-0 mt-0 rounded-[3px] bg-[#ede5d8] px-4 py-3.5 text-center text-[13px] leading-normal text-muted">
            Please send payment to the number/account above and use reference no. <strong class="text-ink" data-receipt="ref-note"></strong>. Our team will confirm once received.
        </p>

        <p class="{{ error_box }}" role="alert" data-order-error hidden></p>

        <div class="mt-5 flex gap-3">
            <button type="button" class="{{ btn_ghost }}" data-order-back>Back</button>
            <button type="button" class="{{ btn_main }}" data-order-finish>Done — Confirm Order</button>
        </div>
    </div>

    {# Success #}
    <div class="px-8 pb-8 pt-7 text-center" data-order-panel="success" hidden>
        <p class="mb-2 mt-0 text-4xl" aria-hidden="true">🌸</p>
        <p class="m-0 font-serif text-xl font-bold">Thank you for your order!</p>
        <p class="mb-0 mt-3 text-sm text-muted">Order reference <strong class="text-ink" data-success-reference></strong>. You can follow it under My Orders.</p>
        <div class="mt-6 flex gap-3">
            <button type="button" class="{{ btn_main }}" data-order-close>Close</button>
        </div>
    </div>
</dialog>
