{% extends 'admin/base.html.twig' %}

{% set active_nav = 'categories' %}
{% set page_overline = 'Records' %}
{% set page_title = category.categoryname %}

{% block title %}{{ category.categoryname }} · KDesigns{% endblock %}

{% block body %}
    <section class="table-card profile" style="display:block;max-width:720px">
        <dl>
            <dt>Name</dt><dd>{{ category.categoryname }}</dd>
            <dt>Description</dt><dd>{{ category.description }}</dd>
        </dl>
    </section>

    <div class="row-actions" style="margin-top:16px">
        <a href="{{ path('app_category_index') }}" class="btn-filter">Back to list</a>
        <a href="{{ path('app_category_edit', {id: category.id}) }}" class="btn-filter">Edit</a>
        {{ include('category/_delete_form.html.twig') }}
    </div>
{% endblock %}
