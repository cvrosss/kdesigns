{% extends 'admin/base.html.twig' %}

{% set active_nav = 'categories' %}
{% set page_overline = 'Records' %}
{% set page_title = 'Categories' %}

{% block title %}Categories · KDesigns{% endblock %}

{% block body %}
    <div class="filters">
        <span class="filters__count">{{ categories|length }} categories</span>
        <a href="{{ path('app_category_new') }}" class="btn-save">+ Add Category</a>
    </div>

    <div class="table-card">
        <table class="data-table data-table--stack">
            <thead>
                <tr><th>Name</th><th>Description</th><th>Actions</th></tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    <tr>
                        <td data-label="Name">{{ category.categoryname }}</td>
                        <td data-label="Description">{{ category.description }}</td>
                        <td data-label="">
                            <div class="row-actions">
                                <a href="{{ path('app_category_show', {id: category.id}) }}" class="btn-filter">View</a>
                                <a href="{{ path('app_category_edit', {id: category.id}) }}" class="btn-filter">Edit</a>
                                {{ include('category/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="empty-state">No categories yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
