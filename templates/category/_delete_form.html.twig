<form method="post" action="{{ path('app_category_delete', {id: category.id}) }}" onsubmit="return confirm('Delete the category {{ category.categoryname|e('js') }}? This cannot be undone.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
    <button type="submit" class="btn-danger">Delete</button>
</form>
