{% extends 'admin/base.html.twig' %}

{% set active_nav = 'inventory' %}
{% set page_overline = 'Inventory' %}
{% set page_title = 'Inventory System' %}

{% block title %}Inventory System · KDesigns Admin{% endblock %}

{% block body %}
    <div class="filters">
        <div class="filters__group">
            <a href="{{ path('app_inventory') }}" class="btn-filter{{ active_filter == '' ? ' is-active' : '' }}">All Products</a>
            <a href="{{ path('app_inventory', {filter: 'low'}) }}" class="btn-filter{{ active_filter == 'low' ? ' is-active' : '' }}">Low Stock</a>
            <a href="{{ path('app_inventory', {filter: 'out'}) }}" class="btn-filter{{ active_filter == 'out' ? ' is-active' : '' }}">Out of Stock</a>
        </div>
        <span class="filters__count">{{ total_products }} products</span>
    </div>

    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Current Stock</th>
                    <th>Status</th>
                    <th>Restock Qty</th>
                </tr>
            </thead>
            <tbody>
                {% for row in products %}
                    {% set level = row.stock <= 0 ? 'out' : (row.stock <= low_stock_threshold ? 'low' : 'ok') %}
                    <tr>
                        <td>
                            <div class="product">
                                <div class="product__thumb" aria-hidden="true">{% if row.image %}<img src="/{{ row.image }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:inherit" onerror="this.hidden=true">{% endif %}</div>
                                <div>
                                    <div class="product__name">{{ row.name }}</div>
                                    {% if row.tag %}<span class="product__tag">{{ row.tag }}</span>{% endif %}
                                </div>
                            </div>
                        </td>
                        <td class="cell-category">{{ row.category }}</td>
                        <td class="cell-price">₱{{ row.price|number_format }}</td>
                        <td class="cell-stock cell-stock--{{ level }}">{{ row.stock }}</td>
                        <td>
                            {% if level == 'out' %}
                                <span class="status status--out">Out of stock</span>
                            {% elseif level == 'low' %}
                                <span class="status status--low">Only {{ row.stock }} left</span>
                            {% else %}
                                <span class="status status--ok">{{ row.stock }} in stock</span>
                            {% endif %}
                        </td>
                        <td>
                            <form class="restock" method="post" action="{{ path('app_inventory_stock', {id: row.id, filter: active_filter}) }}" onsubmit="this.querySelector('button').disabled = true">
                                <input type="hidden" name="_token" value="{{ csrf_token('stock_' ~ row.id) }}">
                                <input type="number" min="1" max="100000" step="1" name="qty" value="" placeholder="+ Qty" required aria-label="Quantity to add to {{ row.name }}">
                                <button type="submit" class="btn-save">Save</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="empty-state">No products found.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
