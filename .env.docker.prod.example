# Copy to .env.docker.prod (git-ignored) and replace every value before deploying.
#
#   cp .env.docker.prod.example .env.docker.prod
#   docker compose -f compose.prod.yaml --env-file .env.docker.prod up -d --build
#
# Generate the secret and the two passwords with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"

# Signs session, CSRF and remember-me values. The app refuses to boot in prod without it.
APP_SECRET=replace-with-64-hex-characters

# The application connects as this least-privilege user; it is never the root account.
MYSQL_USER=kdesigns
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_DATABASE=kdesigns-db

# Used only by MySQL itself for administration and the healthcheck.
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# The public HTTPS address of the site, used when generating URLs outside a request.
DEFAULT_URI=https://your-domain.example
